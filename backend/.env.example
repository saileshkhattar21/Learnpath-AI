PORT=5000

# Postgres connection string, e.g. postgres://user:password@localhost:5432/learnpath
DATABASE_URL=postgres://user:password@localhost:5432/learnpath

# Clerk (dashboard -> API Keys)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# Optional. This model is supported by Groq's chat completion API.
GROQ_MODEL=llama-3.3-70b-versatile
